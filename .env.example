GCIE_ENV=development
GCIE_LOG_LEVEL=INFO

# Storage (configure later; never commit real credentials)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Exchange API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# On-chain providers
BITQUERY_API_KEY=
ROUTESCAN_API_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional scheduler trigger secret; store the real value only in deployment secrets
SCHEDULER_SHARED_SECRET=
